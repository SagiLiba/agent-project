# NovaOps Company Brain — copy this file to .env and fill in real values.
#   cp .env.example .env
# Never commit .env — it is already in .gitignore.

# --- AWS / Bedrock ------------------------------------------------------------
# Uses the AWS credential chain (default profile / IAM role) — no keys needed
# here if `aws sts get-caller-identity` already works in your shell. Set
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY only if you need to override that.
AWS_REGION=us-east-1

# Cross-region inference-profile ID — verified working 2026-09-18.
BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0

# Titan Text Embeddings V2 — verified working 2026-09-18 (256-dim vectors).
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# --- MCP tool server -----------------------------------------------------------
# Port 9878, distinct from Lesson 8/9's 9876 and Lesson 10's 9877, so all three
# can run side by side if needed during development.
MCP_SERVER_URL=http://127.0.0.1:9878/mcp

# --- Database ------------------------------------------------------------------
NOVAOPS_DB_PATH=./novaops.db
NOVAOPS_DATASET_ROOT=./novaops-enterprise-agent-dataset

# --- Agent backbone (Step 5) -----------------------------------------------------
# Durable LangGraph checkpoints (AsyncSqliteSaver) — separate file from
# novaops.db so wiping/reseeding the app db never touches conversation/approval
# state, and vice versa. Required for the Webex approval gate to survive a
# process restart (Milestone 4).
NOVAOPS_CHECKPOINT_PATH=./novaops_checkpoints.db

# Print each node's decision (scope, intent, loadout, tool calls) to stdout as
# the graph runs. Set to 0 once Step 9 wires real Langfuse spans.
NOVAOPS_TRACE=1

# --- Langfuse (Milestone 5 — required) ------------------------------------------
# Create a project at https://cloud.langfuse.com (EU region, matches course
# default), then Settings -> API Keys -> paste the three values it generates.
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL="https://cloud.langfuse.com"
